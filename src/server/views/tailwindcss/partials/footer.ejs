<footer class="w-full text-xs text-gray-600 dark:text-gray-400 py-2 border-t border-gray-200 dark:border-gray-700 bg-white/80 dark:bg-gray-800/80 backdrop-blur-md shadow-sm">
  <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-x-4 gap-y-1 px-2 text-[0.75rem] leading-snug">
    <div>
      <% if (appBuild?.version) { %>
        <small class="cursor-default">v<%= appBuild.version %></small>
        <% if (appBuild?.commit) { %>
          <span class="mx-1 text-gray-300 dark:text-gray-600">&bull;</span>
          <a href="<%= appBuild.commitUrl %>" target="_blank" rel="noopener noreferrer"
             class="text-blue-600 hover:underline font-mono" title="View commit <%= appBuild.commit %> on GitHub">
            <%= appBuild.branch ? (appBuild.branch + '@') : '' %><%= appBuild.commit %>
          </a>
        <% } %>
      <% } %>
    </div>
    <div class="flex items-center space-x-2">
      <small>&copy; 2024–<%= new Date().getFullYear() %></small>
      <% if (locals.appPublic) { %>
      <img src="<%= locals.appPublic %>/brand/icon-32.png" alt="" class="w-4 h-4" />
      <a href="<%= locals.appPublic %>" class="text-blue-600 hover:underline whitespace-nowrap"><%= locals.companyName || 'HCS' %></a>
      <% } else { %>
      <span class="whitespace-nowrap"><%= locals.companyName || 'HCS' %></span>
      <% } %>
    </div>
    <% if (locals.appPublic) { %>
    <div class="flex items-center space-x-2">
      <small>
        <a href="<%= locals.appPublic %>/legal/privacy-policy" class="hover:underline">Privacy</a>
        <span class="mx-1 text-gray-300 dark:text-gray-600">&bull;</span>
        <a href="<%= locals.appPublic %>/legal/cookie-policy" class="hover:underline">Cookies</a>
        <span class="mx-1 text-gray-300 dark:text-gray-600">&bull;</span>
        <a href="<%= locals.appPublic %>/legal/terms" class="hover:underline">Terms</a>
      </small>
    </div>
    <% } %>
  </div>
  <!-- Toast container -->
  <div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2"></div>
</footer>
