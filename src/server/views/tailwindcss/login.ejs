<%#
  Sign-in page. Styled to match hcs-app's login card (green accent bar,
  header row, compact fields, full-width green button) so moving between
  the two apps feels like one product. Behaviour is hcs-sync's own: posts to
  /login, checks Turnstile, and passes an optional TOTP code through to
  hcs-app's SSO token endpoint.

  Locals: next, skipTurnstile, siteKey (routes/auth.js GET /login).
%>
<% const _input = 'w-full px-3.5 py-2 border border-gray-200 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500 bg-gray-50 dark:bg-gray-800 text-sm text-gray-900 dark:text-gray-100'; %>
<% const _label = 'block mb-1 text-sm font-medium text-gray-700 dark:text-gray-300'; %>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<div class="max-w-md mx-auto py-10 px-4">
  <div class="bg-white dark:bg-gray-900 shadow-lg rounded-2xl overflow-hidden">
    <div class="h-1.5 bg-gradient-to-r from-green-500 to-emerald-400"></div>
    <div class="border-b border-gray-200 dark:border-gray-700 px-6 py-3 font-semibold text-sm text-gray-900 dark:text-gray-100 flex items-center gap-2">
      <i class="bi bi-box-arrow-in-right text-green-600 dark:text-green-400" aria-hidden="true"></i>
      <h1>Log in</h1>
    </div>
    <div class="p-6">
      <% if (skipTurnstile) { %>
      <div class="mb-4 p-3 rounded-xl bg-amber-50 dark:bg-amber-900/30 text-amber-800 dark:text-amber-300 text-sm border border-amber-200 dark:border-amber-800">
        CAPTCHA bypass is active (non-production environment or SKIP_TURNSTILE=true). Turnstile always runs in production.
      </div>
      <% } %>

      <form action="/login" method="POST" class="space-y-4">
        <div>
          <label for="username" class="<%= _label %>">Username or email</label>
          <input type="text" id="username" name="username" required autofocus autocomplete="username" class="<%= _input %>">
        </div>

        <div>
          <label for="password" class="<%= _label %>">Password</label>
          <input type="password" id="password" name="password" required autocomplete="current-password" class="<%= _input %>">
        </div>

        <!-- Required only for accounts with two-factor sign-in turned on -->
        <div>
          <label for="totp" class="<%= _label %>">Two-factor code <span class="text-gray-400 dark:text-gray-500 font-normal">(if enabled)</span></label>
          <input type="text" id="totp" name="totp" inputmode="numeric" pattern="[0-9]*" maxlength="6" autocomplete="one-time-code" placeholder="123456" class="<%= _input %>">
        </div>

        <% if (!skipTurnstile) { %>
        <div class="cf-turnstile" data-sitekey="<%= siteKey %>"></div>
        <% } %>

        <button type="submit" class="w-full inline-flex items-center justify-center gap-1.5 px-6 py-2.5 rounded-lg text-sm font-medium bg-green-600 text-white hover:bg-green-700 transition shadow-sm focus:ring-4 focus:ring-green-300 dark:focus:ring-green-800">
          <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Log in
        </button>
        <%# Hidden fields last: as first children they'd count as siblings for space-y and push the first field down %>
        <%- include('./partials/csrfHidden.ejs') %>
        <input type="hidden" name="next" value="<%= next %>">
        <% if (skipTurnstile) { %>
        <input type="hidden" name="cf-turnstile-response" value="bypassed">
        <% } %>
      </form>

      <div class="mt-4 flex items-center justify-center gap-2 text-sm">
        <a href="https://app.heroncs.co.uk/user/forgot-password" class="text-green-700 dark:text-green-400 hover:underline">Forgot your password?</a>
        <span class="text-gray-300 dark:text-gray-600" aria-hidden="true">&middot;</span>
        <a href="https://app.heroncs.co.uk/user/register" class="text-green-700 dark:text-green-400 hover:underline">Create an account</a>
      </div>
    </div>
  </div>
</div>
